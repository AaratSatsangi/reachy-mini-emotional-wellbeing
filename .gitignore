# =============================================================================
# Standalone Project Webpage .gitignore
# Strictly for PHP/HTML/CSS/JS research explainers & interactive web demonstrators
# =============================================================================

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local Configuration Overrides (never commit private endpoint keys or credentials)
config.local.json
.env
.env.local
*.pem
*.key

# Temporary Demo Uploads & Caches
temp/
tmp/
assets/temp/
uploads/temp/
*.log
